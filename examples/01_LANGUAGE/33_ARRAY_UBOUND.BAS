10 REM BASIC-58 ARRAY UBOUND EXAMPLE
20 REM -----------------------------
30 DIM NUMBERS(10)
40 PRINT "ARRAY SIZE: "; UBOUND(NUMBERS)
50 PRINT
60 REM FILL THE ARRAY WITH SQUARES
70 FOR I = 1 TO UBOUND(NUMBERS)
80 LET NUMBERS(I) = I * I
90 NEXT I
100 REM DISPLAY ARRAY CONTENTS
110 PRINT "ARRAY CONTENTS:"
120 FOR I = 1 TO UBOUND(NUMBERS)
130 PRINT I; " -> "; NUMBERS(I)
140 NEXT I
150 PRINT
160 PRINT "LAST ELEMENT: "; NUMBERS(UBOUND(NUMBERS))
170 END