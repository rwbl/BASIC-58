10 REM BASIC-58 ARRAY SWAP EXAMPLE
20 REM ---------------------------
30 DIM A(5)
40 LET A(1) = 100
50 LET A(2) = 200
60 LET B = 300
70 PRINT "INITIAL VALUES:"
80 PRINT "A(1) = "; A(1)
90 PRINT "A(2) = "; A(2)
100 PRINT "B    = "; B
110 PRINT
120 REM SWAP TWO ARRAY ELEMENTS
130 SWAP A(1), A(2)
140 PRINT "AFTER SWAP A(1), A(2):"
150 PRINT "A(1) = "; A(1)
160 PRINT "A(2) = "; A(2)
170 PRINT
180 REM SWAP VARIABLE AND ARRAY ELEMENT
190 SWAP B, A(1)
200 PRINT "AFTER SWAP B, A(1):"
210 PRINT "A(1) = "; A(1)
220 PRINT "B    = "; B
230 PRINT
240 REM SWAP TWO VARIABLES
250 SWAP A(1), B
260 PRINT "AFTER SWAP A(1), B:"
270 PRINT "A(1) = "; A(1)
280 PRINT "B    = "; B
290 END