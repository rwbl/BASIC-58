10 REM NUMBER GUESSING GAME
20 RANDOMIZE
30 LET SECRET = INT(RND(1) * 100) + 1
40 LET TRIES = 0
50 PRINT "****************************"
60 PRINT "*      expBASIC GAME       *"
70 PRINT "****************************"
80 PRINT ""
90 PRINT "I AM THINKING OF A NUMBER"
100 PRINT "BETWEEN 1 AND 100."
110 PRINT ""
120 INPUT "YOUR GUESS"; GUESS
130 LET TRIES = TRIES + 1
140 IF GUESS = SECRET THEN 200
150 IF GUESS < SECRET THEN 180
160 PRINT "TOO HIGH!"
170 GOTO 190
180 PRINT "TOO LOW!"
190 GOTO 120
200 PRINT ""
210 PRINT "CONGRATULATIONS!"
220 PRINT "YOU FOUND IT IN "; TRIES; " TRIES."
230 END