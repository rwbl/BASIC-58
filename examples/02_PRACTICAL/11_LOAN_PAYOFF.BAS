10 REM LOAN PAYOFF ESTIMATE WITH FIXED MONTHLY PAYMENT
20 PRINT "LOAN PAYOFF ESTIMATE"
30 INPUT "LOAN AMOUNT"; B
40 INPUT "ANNUAL INTEREST RATE (%)"; R
50 INPUT "MONTHLY PAYMENT"; P
60 IF B <= 0 THEN 900
70 IF R < 0 THEN 900
80 IF P <= 0 THEN 900
90 LET M = R / 1200
100 FOR I = 1 TO 360
110 LET J = B * M
120 IF P <= J THEN 950
130 LET B = B + J - P
140 IF B <= 0 THEN 200
150 NEXT I
160 PRINT "NOT PAID OFF WITHIN 30 YEARS"
170 END
200 PRINT "PAID OFF IN MONTH: "; I
210 END
900 PRINT "INVALID INPUT"
910 END
950 PRINT "PAYMENT TOO LOW"
960 END
