10 REM SAVINGS WITH MONTHLY COMPOUND INTEREST
20 PRINT "COMPOUND INTEREST"
30 INPUT "STARTING AMOUNT"; P
40 INPUT "ANNUAL INTEREST RATE (%)"; R
50 INPUT "MONTHLY DEPOSIT"; D
60 INPUT "NUMBER OF MONTHS"; N
100 LET M = R / 1200
110 FOR I = 1 TO N
120 LET P = P * (1 + M) + D
130 NEXT I
140 PRINT "FINAL BALANCE: "; P
150 END
