10 REM CLASS TEST RESULTS
20 PRINT "CLASS RESULTS"
30 DATA 78, 92, 65, 88, 71, 95, 83, 76
40 LET N = 8
50 LET TOTAL = 0
60 FOR I = 1 TO N
70 READ MARK
80 LET TOTAL = TOTAL + MARK
90 NEXT I
100 LET AVG = TOTAL / N
110 PRINT "NUMBER OF STUDENTS: "; N
120 PRINT "TOTAL MARKS: "; TOTAL
130 PRINT "AVERAGE: "; AVG
140 END
