05 REM ENVIRONMENT MONITOR TEST
10 PRINT "ENVIRONMENT MONITOR"
20 PRINT "CONNECTING TO ARDUINO..."
30 @SER CONNECT COM10
40 LET COUNT = 0
50 LET LED = -1

60 REM WAIT FOR NEXT TEMPERATURE
70 ASSIGN TEMP
80 PRINT "TEMPERATURE: "; TEMP

90 IF TEMP > 15 THEN 150

100 REM TEMPERATURE <= 15
110 IF LED = 0 THEN 190
120 LET LED = 0
130 PRINT "LED OFF"
140 @SER 18 4 0
145 GOTO 190

150 REM TEMPERATURE > 15
160 IF LED = 1 THEN 190
170 LET LED = 1
180 PRINT "LED ON"
185 @SER 18 4 1

190 LET COUNT = COUNT + 1
200 IF COUNT < 10 THEN 60

210 PRINT "DISCONNECTING..."
220 @SER DISCONNECT
230 PRINT "TEST COMPLETED"
240 END
