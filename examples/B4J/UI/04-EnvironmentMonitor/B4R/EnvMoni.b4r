Build1=Default,B4RDev
Group=Default Group
Library1=rcommuart
Library2=rcore
Module1=|relative|..\Shared\EnvironmentProtocol
NumberOfFiles=0
NumberOfLibraries=2
NumberOfModules=1
Version=4.2
@EndOfDesignText@
'==============================================
' Project:      EnvironmentMonitor
' Brief:        Arduino UNO environment simulator.
' Date:         2026-11-25
' Author:       Robert W.B. Linn (c) 2026 MIT
' Description:  Simulates temperature and humidity values.
'               Sends temperature updates to the host.
'               Responds to humidity requests.
'               Controls an LED on host command.
' Protocol:     See Shared/EnvironmentProtocol.bas
' DependsOn:    rCommUart v1.10 or higher
' IMPORTANT:    Use IDE Log ONLY for Errors.
' Hardware:     Arduino UNO
' Software:     B4R 4.00 (64 bit)
' Wiring:       LED (DFRobot): D4 = Signal - White;
'               5V = VCC; GND = GND
'==============================================

#Region Project Attributes
	#AutoFlushLogs: True
	#CheckArrayBounds: True
	#StackBufferSize: 600
#End Region

Sub Process_Globals
	Public SerialLine 			As Serial			' UART0 (Port 0)

	' Devices	
	' GPIO
	Private Led 				As Pin				' See B58 protocol
	Private LED_PINNR			As Byte = 0x04
	
	' Simulation Timer
	Private SimTimer 			As Timer	
	
	' Env Data
	' Sensors
	Private TemperatureValue As Byte = 50
	Private HumidityValue As Byte = 50
	
	' Helper
	Private bc					As ByteConverter	'ignore. For testing only, i.e. write to log
End Sub

Private Sub AppStart
	' Init serial line first (always do that)
	SerialLine.Initialize(115200)

	' Init Addresses
	
	' Init GPIO
	Led.Initialize(LED_PINNR, Led.MODE_OUTPUT)
	Led.DigitalWrite(False)
	
	' Init CommUART instance
	CommUart.Initialize(SerialLine.Stream, EnvironmentProtocol.FRAME_SIZE)

	SimTimer.Initialize("SimTimer_Tick", 2000)
	SimTimer.Enabled = True
End Sub

'----------------------------------------------
' TEST ROUTINES
'----------------------------------------------

' Test(EnvironmentProtocol.LED_ADR, EnvironmentProtocol.LED_CMD, EnvironmentProtocol.STATE_ON)
' Delay(2000)
' Test(EnvironmentProtocol.LED_ADR, EnvironmentProtocol.LED_CMD, EnvironmentProtocol.STATE_OFF)
Private Sub Test(adr As Byte, cmd As Byte, val As Byte)	'ignore
	CommUART_OnReceived(EnvironmentProtocol.CreateFrame(adr, cmd, val))
End Sub

'----------------------------------------------
' COMMUART
'----------------------------------------------
Sub SimTimer_Tick
	' Create the values
	TemperatureValue = Rnd(10, 21)
	HumidityValue = Rnd(0, 101)

	Dim Frame() As Byte = EnvironmentProtocol.CreateFrame( _
		EnvironmentProtocol.TEMP_ADR, _
		EnvironmentProtocol.TEMP_CMD, _
		TemperatureValue)

	CommUART_Write(Frame)
End Sub

'----------------------------------------------
' COMMUART
'----------------------------------------------

' CommUART_OnReceived
' Handle new data from the client.
' Parameter:
'	buffer - byte array received
Public Sub CommUART_OnReceived(frame() As Byte)

	If Not(EnvironmentProtocol.CheckFrame(frame)) Then Return

	Dim adr As Byte = EnvironmentProtocol.GetAdr(frame)
	Dim cmd As Byte = EnvironmentProtocol.GetCmd(frame)
	Dim val As Byte = EnvironmentProtocol.GetVal(frame)

	Select adr
		Case EnvironmentProtocol.HUM_ADR
			If cmd = EnvironmentProtocol.HUM_REQUEST_CMD And val = 0 Then

				' Acknowledge the request.
				CommUART_Write(EnvironmentProtocol.CreateFrame( _
            		adr, cmd, val))

				' Send the humidity value.
				CommUART_Write(EnvironmentProtocol.CreateFrame( _
		            EnvironmentProtocol.HUM_ADR, _
		            EnvironmentProtocol.HUM_CMD, _
		            HumidityValue))

			Else
				CommUART_Write(EnvironmentProtocol.CreateFrame( _
		            adr, cmd, EnvironmentProtocol.STATE_ERR))
			End If


		Case EnvironmentProtocol.LED_ADR
			Select cmd
				Case EnvironmentProtocol.LED_CMD
					If val = EnvironmentProtocol.STATE_OFF Or val = EnvironmentProtocol.STATE_ON Then
						Led.DigitalWrite(val = EnvironmentProtocol.STATE_ON)

						' Acknowledge successful command by echoing the frame.
						CommUART_Write(EnvironmentProtocol.CreateFrame(adr, cmd, val))
					Else
						CommUART_Write(EnvironmentProtocol.CreateFrame(adr, cmd, EnvironmentProtocol.STATE_ERR))
					End If

				Case Else
					CommUART_Write(EnvironmentProtocol.CreateFrame(adr, cmd, EnvironmentProtocol.STATE_ERR))
			End Select

		Case Else
			CommUART_Write(EnvironmentProtocol.CreateFrame(adr, cmd, EnvironmentProtocol.STATE_ERR))
	End Select
End Sub

' CommUART_OnError
Public Sub CommUART_OnError
	Log("[Main.CommUART_OnError][E]")
End Sub

' CommUART_Write
' Write data to the connected client.
' Parameter:
'	data - Byte array with framesize length
Private Sub CommUART_Write(data() As Byte)
	CommUart.Write(data)
End Sub
