10 REM SIMPLE DATA STATISTICS
20 REM READ EIGHT VALUES AND CALCULATE SUMMARY
30 DATA 10,20,15,25,30,20,10,30
40 LET SUM=0
50 LET MIN=999
60 LET MAX=-999
70 FOR I=1 TO 8
80 READ X
90 LET SUM=SUM+X
100 IF X<MIN THEN 130
110 GOTO 140
130 LET MIN=X
140 IF X>MAX THEN 170
150 GOTO 180
170 LET MAX=X
180 NEXT I
190 LET AVG=SUM/8
200 PRINT "COUNT: ";8
210 PRINT "TOTAL: ";SUM
220 PRINT "AVERAGE: ";AVG
230 PRINT "MINIMUM: ";MIN
240 PRINT "MAXIMUM: ";MAX
250 END
