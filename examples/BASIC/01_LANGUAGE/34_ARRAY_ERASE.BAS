10 REM BASIC-58 ARRAY ERASE EXAMPLE
20 REM ----------------------------
30 DIM A(5)
40 PRINT "ARRAY SIZE: "; UBOUND(A)
50 LET A(1) = 100
60 LET A(2) = 200
70 LET A(3) = 300
80 PRINT
90 PRINT "BEFORE ERASE:"
100 FOR I = 1 TO UBOUND(A)
110 PRINT "A("; I; ") = "; A(I)
120 NEXT I
130 PRINT
140 REM REMOVE THE ARRAY
150 ERASE A
160 PRINT "ARRAY A HAS BEEN ERASED."
170 PRINT
180 REM DECLARE THE ARRAY AGAIN
190 DIM A(3)
200 PRINT "ARRAY A DECLARED AGAIN."
210 PRINT "NEW ARRAY SIZE: "; UBOUND(A)
220 PRINT
230 PRINT "NEW ARRAY CONTENTS:"
240 FOR I = 1 TO UBOUND(A)
250 PRINT "A("; I; ") = "; A(I)
260 NEXT I
270 END
