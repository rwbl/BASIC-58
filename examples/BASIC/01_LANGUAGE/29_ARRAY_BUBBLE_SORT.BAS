10 DIM A(8)
20 FOR I = 1 TO 8
30 INPUT "VALUE"; X
35 LET A(I) = X
40 NEXT I

50 FOR I = 1 TO 7
60 FOR J = 1 TO 8 - I
70 IF A(J) > A(J + 1) THEN 75
72 GOTO 80
75 LET T = A(J)
76 LET A(J) = A(J + 1)
77 LET A(J + 1) = T
80 NEXT J
90 NEXT I

100 PRINT "SORTED VALUES"
110 FOR I = 1 TO 8
120 PRINT I; "="; A(I)
130 NEXT I
140 END
