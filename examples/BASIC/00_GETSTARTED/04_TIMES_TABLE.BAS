10 PRINT "MULTIPLICATION CHALLENGE"
20 RANDOMIZE
30 LET A = INT(RND(1) * 10) + 1
40 LET B = INT(RND(1) * 10) + 1
50 PRINT "WHAT IS "; A; " TIMES "; B; "?"
60 INPUT "YOUR ANSWER"; ANSWER
70 LET CORRECT = A * B
80 IF ANSWER = CORRECT THEN 120
90 PRINT "NOT QUITE! THE ANSWER IS "; CORRECT
100 GOTO 130
120 PRINT "WELL DONE! THAT IS CORRECT!"
130 END
