10 PRINT "TREASURE HUNT"
20 PRINT "FIND THE TREASURE ON A 5 BY 5 GRID."
30 RANDOMIZE
40 LET TX = INT(RND(1) * 5) + 1
50 LET TY = INT(RND(1) * 5) + 1
60 INPUT "YOUR X POSITION (1 TO 5)"; X
70 INPUT "YOUR Y POSITION (1 TO 5)"; Y
80 IF X = TX THEN 100
90 GOTO 130
100 IF Y = TY THEN 200
110 GOTO 160
130 IF X < TX THEN 150
140 PRINT "MOVE WEST"
145 GOTO 160
150 PRINT "MOVE EAST"
160 IF Y = TY THEN 190
170 IF Y < TY THEN 180
175 PRINT "MOVE SOUTH"
176 GOTO 60
180 PRINT "MOVE NORTH"
185 GOTO 60
190 PRINT "YOUR Y POSITION IS CORRECT!"
195 GOTO 60
200 PRINT "YOU FOUND THE TREASURE!"
210 END
