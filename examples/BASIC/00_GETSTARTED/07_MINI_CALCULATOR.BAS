10 PRINT "MINI CALCULATOR"
20 PRINT "1 = ADD"
30 PRINT "2 = SUBTRACT"
40 PRINT "3 = MULTIPLY"
50 PRINT "4 = DIVIDE"
60 INPUT "CHOOSE 1 TO 4"; CHOICE
70 INPUT "FIRST NUMBER"; A
80 INPUT "SECOND NUMBER"; B
90 IF CHOICE = 1 THEN 130
100 IF CHOICE = 2 THEN 150
110 IF CHOICE = 3 THEN 170
120 IF CHOICE = 4 THEN 190
125 PRINT "THAT IS NOT A VALID CHOICE."
126 GOTO 200
130 LET RESULT = A + B
140 GOTO 210
150 LET RESULT = A - B
160 GOTO 210
170 LET RESULT = A * B
180 GOTO 210
190 IF B = 0 THEN 230
195 LET RESULT = A / B
200 GOTO 210
210 PRINT "RESULT:"; RESULT
220 END
230 PRINT "YOU CANNOT DIVIDE BY ZERO!"
240 END
