10 PRINT "GUESS MY NUMBER"
20 PRINT "I AM THINKING OF A NUMBER FROM 1 TO 100."
30 RANDOMIZE
40 LET SECRET = INT(RND(1) * 100) + 1
50 LET TRIES = 0
60 INPUT "YOUR GUESS"; GUESS
70 LET TRIES = TRIES + 1
80 IF GUESS = SECRET THEN 150
90 IF GUESS < SECRET THEN 120
100 PRINT "TOO HIGH! TRY A SMALLER NUMBER."
110 GOTO 130
120 PRINT "TOO LOW! TRY A BIGGER NUMBER."
130 IF TRIES < 7 THEN 60
140 PRINT "NO MORE GUESSES. THE NUMBER WAS"; SECRET
145 GOTO 160
150 PRINT "YOU FOUND IT IN "; TRIES; " GUESSES!"
160 END
