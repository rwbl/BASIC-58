10 @SER CONNECT COM10
11 PRINT "Collecting Data..."
20 DIM TEMP(10)
30 FOR I = 1 TO 10
40 ASSIGN TEMP(I)
50 NEXT I
51 PRINT "Data collected."
60 LET TOTAL = 0
70 FOR I = 1 TO 10
80 LET TOTAL = TOTAL + TEMP(I)
90 NEXT I
91 PRINT "===================="
100 PRINT "AVERAGE: "; TOTAL / 10
110 @SER DISCONNECT
120 END