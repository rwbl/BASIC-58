10 REM SERIAL ARRAY DATA ACQUISITION
20 REM COLLECT 10 TEMPERATURE READINGS
30 @SER CONNECT COM10
40 DIM TEMP(10)
50 PRINT "COLLECTING DATA..."
60 FOR I = 1 TO 10
70 ASSIGN TEMP(I)
80 NEXT I
90 PRINT "DATA COLLECTED."
100 PRINT "===================="
110 LET TOTAL = 0
120 FOR I = 1 TO 10
130 LET TOTAL = TOTAL + TEMP(I)
140 NEXT I
150 PRINT "AVERAGE: "; TOTAL / 10
160 @SER DISCONNECT
170 END
