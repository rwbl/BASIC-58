10 REM LOAN PAYMENT ESTIMATE
20 PRINT "MONTHLY LOAN PAYMENT"
30 INPUT "LOAN AMOUNT"; P
40 INPUT "ANNUAL INTEREST RATE (%)"; R
50 INPUT "YEARS"; Y
60 IF P <= 0 THEN PRINT "INVALID LOAN AMOUNT": END
70 IF R < 0 THEN PRINT "INVALID INTEREST RATE": END
80 IF Y < 1 THEN PRINT "INVALID TERM": END
90 N = Y * 12
100 IF R = 0 THEN PAYMENT = P / N: GOTO 140
110 M = R / 1200
120 PAYMENT = P * M / (1 - (1 + M) ^ (0 - N))
130 GOTO 150
140 PRINT "NO-INTEREST LOAN"
150 PRINT "MONTHLY PAYMENT: "; PAYMENT
160 PRINT "TOTAL PAID: "; PAYMENT * N
170 END
