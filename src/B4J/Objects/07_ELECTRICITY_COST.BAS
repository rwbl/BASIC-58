10 REM SIMPLE ELECTRICITY COST ESTIMATE
20 PRINT "ELECTRICITY COST"
30 INPUT "POWER IN WATTS"; W
40 INPUT "HOURS PER DAY"; H
50 INPUT "PRICE PER KWH"; P
60 INPUT "NUMBER OF DAYS"; D
70 IF W < 0 THEN 900
80 IF H < 0 THEN 900
90 IF P < 0 THEN 900
100 IF D < 1 THEN 900
110 LET K = W * H * D / 1000
120 LET C = K * P
130 PRINT "ENERGY: "; K; " KWH"
140 PRINT "COST: "; C
150 END
900 PRINT "INVALID INPUT"
910 END
