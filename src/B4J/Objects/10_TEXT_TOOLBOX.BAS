10 REM STRING FUNCTIONS
20 LET A$ = "BASIC-58 INTERPRETER"
30 PRINT "TEXT: "; A$
40 PRINT "LENGTH: "; LEN(A$)
50 PRINT "LEFT: "; LEFT$(A$, 5)
60 PRINT "RIGHT: "; RIGHT$(A$, 11)
70 PRINT "MIDDLE: "; MID$(A$, 7, 3)
80 PRINT "FIRST CHARACTER CODE: "; ASC(LEFT$(A$, 1))
90 PRINT "NUMBER FROM TEXT: "; VAL("123.5")
100 END
