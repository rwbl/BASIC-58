10 REM PROCESS DATA AND REPORT
20 PRINT "WEEKLY PRODUCTION REPORT"
30 DATA 125, 132, 118, 145, 139, 151, 147
40 LET N = 7
50 LET TOTAL = 0
60 LET LOW = 999999
70 LET HIGH = 0
80 FOR I = 1 TO N
90 READ V
100 LET TOTAL = TOTAL + V
105 IF V >= LOW THEN 120
110 LET LOW = V
120 IF V <= HIGH THEN 140
130 LET HIGH = V
140 NEXT I
150 LET AVG = TOTAL / N
160 PRINT "SAMPLES: "; N
170 PRINT "TOTAL: "; TOTAL
180 PRINT "AVERAGE: "; AVG
190 PRINT "MINIMUM: "; LOW
200 PRINT "MAXIMUM: "; HIGH
210 END
