10 REM DICE GAME - PSEUDORANDOM VALUES
20 PRINT "DICE ROLL SIMULATION"
30 INPUT "NUMBER OF ROLLS"; N
40 IF N < 1 THEN 900
50 FOR I = 1 TO N
60 LET D1 = INT(RND(1) * 6) + 1
70 LET D2 = INT(RND(1) * 6) + 1
80 LET T = D1 + D2
90 PRINT "ROLL "; I; ": "; D1; " + "; D2; " = "; T
100 NEXT I
110 END
900 PRINT "INVALID ROLL COUNT"
910 END
